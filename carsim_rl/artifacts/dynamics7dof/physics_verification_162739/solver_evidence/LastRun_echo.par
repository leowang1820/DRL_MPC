!------------------------------------------------------------------------------------
! IMPORTED VARIABLES, RELATIONS TO NATIVE VARIABLES, INITIAL VALUES, and UNITS
!------------------------------------------------------------------------------------
IMPORT IMP_THROTTLE_ENGINE REPLACE 0 ; - ! #1. Open loop throttle control
IMPORT IMP_PCON_BK REPLACE 0 ; MPa ! #2. Brake master cylinder pressure
IMPORT IMP_STEER_SW REPLACE 0 ; deg ! #3. Steering wheel angle

!------------------------------------------------------------------------------------
! EXPORTED VARIABLES
!------------------------------------------------------------------------------------
EXPORT XO           0 ! #1. X coordinate, vehicle origin (m)
EXPORT YO           0 ! #2. Y coordinate, vehicle origin (m)
EXPORT YAW          0 ! #3. Yaw, vehicle (deg)
EXPORT AVZ          0 ! #4. Yaw rate (body-fixed), vehicle (deg/s)
EXPORT LAT_VEH      0 ! #5. Vehicle lateral distance to path (m)
EXPORT LAT_TARG     0 ! #6. Target lateral offset from path (m)
EXPORT VX          40 ! #7. Long. speed, inst. CG, vehicle (km/h)
EXPORT STATION      0 ! #8. Station (path) at vehicle origin (m)
EXPORT VY           0 ! #9. Lat. speed, inst. CG, vehicle (km/h)
EXPORT AVY_L1 300.5759076 ! #10. Wheel L1 spin (rpm)
EXPORT AVY_R1 300.5759076 ! #11. Wheel R1 spin (rpm)
